# ==============================================================================
# AgroDoc — Development Profile (application-dev.properties)
# ==============================================================================
# This file is for LOCAL DEVELOPMENT ONLY.
# Fill in your actual local MySQL credentials and API keys here.
#
# THIS FILE IS LISTED IN .gitignore AND MUST NEVER BE COMMITTED TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database — fill in your local MySQL credentials
# ------------------------------------------------------------------------------
spring.datasource.url=jdbc:mysql://localhost:3306/agrodoc_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_ROOT_PASSWORD

# ------------------------------------------------------------------------------
# JPA — use 'validate' after schema.sql has been run
# Switch to 'none' if you manage schema manually
# ------------------------------------------------------------------------------
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true

# ------------------------------------------------------------------------------
# JWT Secret — replace with a secure random string of at least 32 characters
# Example: generate with: openssl rand -base64 48
# ------------------------------------------------------------------------------
jwt.secret=REPLACE_WITH_YOUR_OWN_SECURE_SECRET_KEY_AT_LEAST_32_CHARS

# ------------------------------------------------------------------------------
# External AI API — fill in after completing Phase 5 API evaluation
# ------------------------------------------------------------------------------
plant.api.key=YOUR_PLANT_API_KEY_HERE
plant.api.base-url=https://plant.id/api/v3

# ------------------------------------------------------------------------------
# File Upload Directory (local path)
# ------------------------------------------------------------------------------
agrodoc.upload.dir=uploads

# ------------------------------------------------------------------------------
# CORS — allow VS Code Live Server default port
# ------------------------------------------------------------------------------
agrodoc.cors.allowed-origins=http://localhost:5500,http://127.0.0.1:5500

# ------------------------------------------------------------------------------
# Logging — more verbose in dev
# ------------------------------------------------------------------------------
logging.level.com.agrodoc=DEBUG
logging.level.org.hibernate.SQL=DEBUG
